# Ruta del vault Markdown (única fuente de verdad)
VAULT_PATH=./vault

# --- Sincronización con Google Workspace (Fase 2) ---
# Directorio con credentials.json y token.json de OAuth2
GOOGLE_CREDENTIALS_DIR=./credentials
# Lista de Google Tasks destino ("@default" = lista principal)
GOOGLE_TASKS_LIST_ID=@default
# Calendario de Google Calendar destino ("primary" = calendario principal)
GOOGLE_CALENDAR_ID=primary
# Activa la sincronización y el polling (false por defecto: no rompe sin credenciales)
GOOGLE_SYNC_ENABLED=false
# Intervalo del polling de Google Tasks en segundos
GOOGLE_POLL_INTERVAL_S=60

# --- Ingesta de tickets con IA (Fase 3) ---
# Proveedor de LLM: openai | anthropic | gemini | ollama (vacío = deshabilitado)
AI_PROVIDER=
# API key del proveedor (no necesaria para ollama)
AI_API_KEY=
# Modelo (opcional; por defecto gpt-4o / claude-3-5-sonnet-latest /
# gemini-2.0-flash / llama3.2-vision según proveedor)
AI_MODEL=
# URL base del servidor Ollama local
OLLAMA_BASE_URL=http://localhost:11434

# --- Domótica MQTT + Home Assistant (Fase 4a) ---
# Host y puerto del broker MQTT (mosquitto en docker-compose)
MQTT_HOST=localhost
MQTT_PORT=1883
# Credenciales del broker (vacío = sin autenticación)
MQTT_USERNAME=
MQTT_PASSWORD=
# Identificador del cliente MQTT
MQTT_CLIENT_ID=homevault-ai
# Activa el conector MQTT (sensores de peso, Discovery de HA y avisos TTS)
MQTT_ENABLED=false

# --- Escaneo de códigos de barras: Open Food Facts (Fase 4b) ---
# URL base de la API de Open Food Facts
OFF_BASE_URL=https://world.openfoodfacts.org
# Timeout de las peticiones HTTP a OFF en segundos
OFF_TIMEOUT_S=10
# TTL de la caché en memoria de productos OFF en segundos
OFF_CACHE_TTL_S=3600
# User-Agent identificativo enviado a la API pública de OFF
OFF_USER_AGENT=HomeVaultAI/0.4 (quantum-homelab; escaneo de despensa)

# --- Impresora térmica ESC/POS (Fase 4c) ---
# Host de la impresora de red (vacío = impresión deshabilitada, 503)
PRINTER_HOST=
# Puerto RAW de la impresora (9100 por defecto en térmicas de red)
PRINTER_PORT=9100

# --- Auto-sincronización Git del vault (Fase 4d) ---
# Activa el push al remote tras cada commit automático
GIT_REMOTE_ENABLED=false
# Ventana de agrupación de ráfagas de cambios en segundos
GIT_DEBOUNCE_S=5

# --- Observador del vault y WebSockets (Fase 4) ---
# Activa el watchdog del vault y la difusión de eventos por /ws
WATCHER_ENABLED=true

# --- CORS del frontend Next.js (Fase 5) ---
# Orígenes permitidos, en formato JSON (lista de strings).
# En despliegue con Cloudflare Tunnel añade el dominio público, p.ej.:
# CORS_ORIGINS=["https://homevault.quantum-homelab.win"]
CORS_ORIGINS=["http://localhost:3000"]

# --- Frontend Next.js (frontend/.env.local, no lo lee el backend) ---
# URL base de la API que consume el frontend. Si está vacío, el frontend
# proxea /api al backend internamente (útil para Cloudflare Tunnel con un
# único dominio público).
NEXT_PUBLIC_API_URL=http://localhost:8000
